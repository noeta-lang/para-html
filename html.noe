// `para.html` — server-side reactive HTML templating, LiveWire/LiveView-style, in pure Noeta. The
// liveview module of the first-party (non-default) `para` namespace. It composes three language
// substrates:
//
//   * expression tiers (expr-tiers arc)      — `@html { … ${expr} … }` is a typed template value;
//   * fine-grained reactivity (std.reactive) — each hole becomes a `computed`, so a signal change
//     recomputes exactly the affected holes;
//   * the reactive-view diff-push transport (std.reactive.view + std.http.server websockets) —
//     which serializes only the holes that changed and pushes a minimal patch to the browser.
//
// A consumer keys this package `para` in `[dependencies]`, imports `render` (which brings the
// `@html` tier declaration into scope) and `handle`, and writes ordinary HTML with `${…}` holes
// over signals. See `examples/liveview-counter/`.
use std.reactive.{signal, computed, view, Signal, Computed, View}
use std.http.server
use std.http.{Request, Response, Socket}
use std.json
use std.datetime

// A compiled `@html` template: the static HTML skeleton (holes rendered as `<span data-live="id">`
// markers, filled with their initial values for a no-flash first paint), the per-hole `computed`s
// the websocket session exposes and diffs, and the marker `id`s (parallel to `holes`) the session
// exposes each computed under. Holes are `dyn` — they *are* `Computed<string>`s, but `view.expose`
// accepts `dyn` and this keeps the field a built-in.
//
// `handlers` is the template's inline event table: an `${on_click(fn() => …)}` hole registers its
// `Binding` here under an auto id (`eN`) and emits a matching `data-live-*` marker, so a client event
// routes straight to the binding at the element — no magic string, no central `on_event` match. The
// table holds whole `Binding`s rather than bare closures so the session can consult each one's guard
// before running it (see `Binding.guard`).
pub struct Html {
    // `skeleton` and `handlers` are the page's inspectable surface: the served markup and the event
    // table a client event routes through. A `struct` is the value kind, so every field here is
    // public and none carries a `pub` — that is what lets a test drive the whole model with no
    // browser and no socket: assert the skeleton escaped a value, look a binding up by its id and
    // `.run` it, exactly the way the websocket session does. The examples under `examples/liveview-*`
    // read them the same way. Anything that should be hidden belongs in a `class`, not here.
    skeleton: string
    holes: List<dyn>
    ids: List<string>
    handlers: Map<string, Binding>
    // Keyed-list regions on this page (one per `${keyed(…)}` hole). The websocket session reconciles
    // each after every event: it diffs the region's key sequence and pushes minimal structural ops
    // (insert / remove / move) so add / prepend / remove / reorder patch in place instead of
    // re-rendering the parent. Empty for a page with no keyed lists.
    regions: List<KeyedRegion>
}

// The typed DOM events a template binds. This enum is the single source of truth for the event path:
// each variant maps to one `data-live-*` wire marker (`wire_attr`) and one client-side listener, so
// no event kind is ever a bare string. `on_click`/`on_input`/`on_submit` construct the `Binding`.
pub enum DomEvent {
    Click
    Input
    Submit
}

// A handler bound inline in a template (`<button ${on_click(fn() => …)}>`). The `@html` handler
// registers the whole binding in the page's `handlers` table under an auto id and emits `event`'s
// marker; the session loop looks it up by id when the client reports the event. `run` receives the
// event payload — empty for a click, the field value for an input, the URL-encoded body for a submit.
//
// `guard`, when present, is re-checked *at event time* — on the same wake as `run`, against current
// state. That is the whole point of it: whether an element was rendered is a decision made once, at
// socket open, and the client outlives it. The handler table is built from one `render_page()` and
// lives for the session, so every id ever registered stays reachable — on a hidden element, on a
// `disabled` one, or under a permission since revoked. Rendering is not authorization; this is.
//
// para/html never builds a guard and never interprets one. It has no notion of a user, a session, or
// a permission — the closure comes from the app, and the only thing this package does is call it.
pub struct Binding {
    event: DomEvent
    run: (string) -> void
    guard: ?() -> bool

    // Gate this binding on a check run at event time:
    //
    //     <button ${on_click(fn() => todos.remove(t.id)).only_if(fn() => user.can_edit(t))}>
    //
    // A false verdict drops the event exactly the way an unknown id is already dropped — silently,
    // with no reply. A denial is either a bug or an attack, and neither wants a UI string this
    // package invented. An app that wants to *say* something writes that check inside `run` instead;
    // `only_if` is for the boundary, not the message.
    pub fn only_if(can: () -> bool): Binding {
        return Binding { event: self.event, run: self.run, guard: some(can) }
    }
}

// The binding a lookup falls back to: bound to nothing, guarded by nothing, does nothing. Exists so
// the dispatch path and the table folds read a total `get_or` rather than an `?Binding` each site has
// to unwrap — an id that is not in the table never reaches it (`handlers.has` gates the dispatch).
fn inert_binding(): Binding {
    return Binding { event: DomEvent.Click, run: fn(_: string) {}, guard: none }
}

// Dispatch one client event against a page's handler table: look the binding up, consult its guard,
// run it. Returns whether the handler actually ran — false for an id that is not in the table, and
// false for a guard that refused. Both are dropped the same way, silently: an unknown id is a stale
// page or a probe, and a refusal is a bug or an attack; neither wants a reply this package invented.
//
// THE dispatch entry point, and the reason it is `pub`. The websocket session calls it, and a
// browserless test drives the exact same function (`examples/liveview-events`) — so the no-socket
// rehearsal of the event model cannot drift from what the server actually does. An unguarded binding
// always runs, so a page that never calls `only_if` behaves precisely as it did before guards existed.
pub fn dispatch(handlers: Map<string, Binding>, name: string, value: string): bool {
    if !handlers.has(name) {
        return false
    }
    b = handlers.get_or(name, inert_binding())
    admitted = match b.guard {
        none => true,
        some(can) => can(),
    }
    if admitted {
        b.run(value)
    }
    return admitted
}

// The `data-live-*` wire marker for an event kind. The client shim (`live_js`) listens for the DOM
// event and reports the bound id under this attribute; `render` emits it; `prefix_markers` namespaces
// it when a region is folded. One place decides the attribute name for all three.
fn wire_attr(e: DomEvent): string {
    return match e {
        DomEvent.Click => "data-live-click",
        DomEvent.Input => "data-live-input",
        DomEvent.Submit => "data-live-submit",
    }
}

// Bind a **click**. The overwhelmingly common case, so it takes a bare `() -> void` — the click
// carries no payload.
pub fn on_click(handler: () -> void): Binding {
    return Binding { event: DomEvent.Click, run: fn(_: string) => handler(), guard: none }
}

// Bind an **input** — the handler receives the field's current value on every keystroke.
pub fn on_input(handler: (string) -> void): Binding {
    return Binding { event: DomEvent.Input, run: handler, guard: none }
}

// Bind a form **submit** — the handler receives the form's **decoded fields**, keyed by input name.
// The client prevents the default navigation so the page stays live.
//
// The wire carries `application/x-www-form-urlencoded` (`title=buy+milk&note=caf%C3%A9`), which is
// what the dispatch table's `Binding.run` delivers. Handing that raw to the handler leaked the
// wire format into every app and made each one re-implement percent-decoding — so this wraps the
// user's handler the way `on_click` does and parses once, through `std.http.server`'s codec.
pub fn on_submit(handler: (Map<string, string>) -> void): Binding {
    return Binding {
        event: DomEvent.Submit,
        run: fn(body: string) => handler(server.parse_form(body)),
        guard: none,
    }
}

// A stylesheet built by the `@css` tier: the rendered CSS text.
pub struct Css {
    text: string
}

// The `@css` expression tier handler — the sibling of `@html`. `@css { .todo { color: ${c} } }`
// evaluates to a `Css` value, so a page's styles are checked, highlighted, and interpolatable
// rather than one long string literal returned from a helper.
//
// A hole renders as its `Display` text with `<` removed. CSS has no HTML escaping, but the
// stylesheet is emitted inside a `<style>` element, and the ONE thing that must not be
// expressible there is a closing tag — `</style>` would end the element and let the rest of the
// value be parsed as markup. Dropping `<` closes that without mangling any legal CSS, which
// never needs the character.
@tier(css, text: "css", expr: Css)
pub fn css(statics: List<string>, holes: List<() -> dyn>): Css {
    mut text = ""
    mut i = 0
    for s in statics {
        text = text ~ s
        if i < holes.len() {
            h = holes[i]
            text = text ~ "${h()}".replace("<", "")
            i = i + 1
        }
    }
    return Css { text: text }
}

// Minimal HTML-text escaping for a *scalar* hole's rendered value (XSS-safe by default).
fn escape(s: string): string {
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

// Escaping for an **attribute value** (inside `"…"`): the text escapes plus the quote.
fn attr_escape(s: string): string {
    return escape(s).replace("\"", "&quot;")
}

// Whether the skeleton so far ends **inside an open tag** — i.e. the hole about to be emitted sits
// in *attribute* position (`<li class="${…}">`) rather than text position. Detected from the
// preceding text: an unclosed `<` (no `>` after the last `<`). Such a hole is inlined (a `<span>`
// wrapper would be illegal inside a tag); a text-position hole gets the reactive `<span>` marker.
fn in_tag(s: string): bool {
    segs = s.split("<")
    if segs.len() <= 1 {
        return false
    }
    return segs[segs.len() - 1].index_of(">") == none
}

// The attribute a hole in *attribute* position sits in: the skeleton so far ends inside an open tag
// at `… name="`, so the name is the last word before that final `=`. `""` when it cannot be read
// (an unquoted or otherwise unusual spelling), which downgrades the hole to inline-only — the old
// behavior, never an error.
fn attr_name_at(s: string): string {
    segs = s.split("<")
    tag = segs[segs.len() - 1].replace("\n", " ").replace("\t", " ")
    parts = tag.split("=")
    if parts.len() < 2 {
        return ""
    }
    words = parts[parts.len() - 2].split(" ")
    return words[words.len() - 1].trim()
}

// Insert `marker` just before the enclosing tag's `>`, so an attribute-position binding can put a
// marker on the *element* — it cannot be emitted at the hole itself, which sits inside a quoted
// attribute value. Returns `s` unchanged when it holds no tag close (the tag continues into a later
// static, and the caller carries the marker forward).
fn inject_at_tag_close(s: string, marker: string): string {
    at = s.index_of(">")
    if at == none {
        return s
    }
    cut = at ?? 0
    // A self-closing `/>` keeps its slash after the marker.
    end = if cut > 0 && s.slice(cut - 1, cut) == "/" then cut - 1 else cut
    return s.slice(0, end) ~ " ${marker}" ~ s.slice(end)
}

// Whether a hole value is itself markup (an `Html` from a nested `@html { … }`, or a `List<Html>`
// from a loop like `${rows.map(...)}`) — such a hole embeds *raw*; every other value is escaped
// text. This is the JSX rule: `{child}` composes, `{text}` is escaped.
fn is_markup(v: dyn): bool {
    return v is Html || v is List<Html>
}

// When a child `Html` is **folded** into a region (a `List<Html>` concatenation, or a keyed row), its
// own `data-live[-html]` markers become inert — the region is patched wholesale via `innerHTML`, so
// the child's markers are never diffed individually. But they still share the DOM `data-live`
// namespace with the *exposed* top-level markers (`hN`), so an unprefixed inner `h1` would be hit by
// a patch to the top-level `h1`. Prefixing folds each region's inner markers into a disjoint,
// deterministic namespace (`<prefix>-hN`) — stable across renders (so unchanged rows stay equal and
// the diff drops them) and never colliding with an exposed id.
fn prefix_markers(s: string, p: string): string {
    return s.replace("data-live=\"h", "data-live=\"${p}-h").replace("data-live-html=\"h", "data-live-html=\"${p}-h").replace("data-live-click=\"e", "data-live-click=\"${p}-e").replace("data-live-input=\"e", "data-live-input=\"${p}-e").replace("data-live-submit=\"e", "data-live-submit=\"${p}-e")
}

// Render one hole value to its HTML string: an `Html`'s skeleton verbatim, a `List<Html>` (a loop)
// concatenated, else the value escaped as text. Folded children get namespaced markers (see above).
fn render_value(v: dyn): string {
    single = v.as<Html>()
    if single != none {
        return prefix_markers((single ?? Html { skeleton: "", holes: [], ids: [], handlers: {}, regions: [] }).skeleton, "s")
    }
    many = v.as<List<Html>>()
    if many != none {
        mut out = ""
        mut idx = 0
        for child in many ?? [] {
            out = out ~ prefix_markers(child.skeleton, "c${idx}")
            idx = idx + 1
        }
        return out
    }
    return escape("${v}")
}

// A **keyed** list of rows (`${keyed(todos, key_of, row)}`) — each row is its *own* persistent
// reactive region, so a change to one row pushes only that row's new markup over the wire (the diff
// drops rows whose rendered value is unchanged), instead of re-`innerHTML`-ing the whole list. On
// top of that, *structural* changes to the key sequence — append, prepend, remove, reorder — patch
// in place: `render` seeds the region's rows, and the websocket `session` reconciles it after every
// event, emitting minimal insert / remove / move ops (see [`reconcile_region`]).
//
// `Keyed` carries the ingredients **deferred** (not pre-expanded): the current key sequence, and per
// key a row `computed`, its wrapper markup, and its inline handlers. All three are captured while the
// element type `T` is still known, then erased — so the value the template hole carries is a plain
// non-generic `Keyed` the checker can recover with `val.as<Keyed>()`.
struct Keyed {
    keys_now: () -> List<string>
    make_row: (string) -> dyn
    row_handlers: (string) -> Map<string, Binding>
}

// A keyed region as the session reconciles it: the stable region id (one per `${keyed(…)}` hole,
// assigned by `render`), the last-rendered key sequence (`prev`, a `signal` so it survives across
// events), and the erased row operations. A row that stays in the set keeps its `computed`; a row
// that leaves is unexposed (its scope torn down); a row that joins gets a fresh `computed`.
pub struct KeyedRegion {
    region: string
    prev: Signal<List<string>>
    keys_now: () -> List<string>
    make_row: (string) -> dyn
    row_handlers: (string) -> Map<string, Binding>
}

// One row's persistent `computed`: it re-derives *its* item from the source signal by key on every
// change (so it subscribes and re-runs), but renders to a value-equal string when the item is
// unchanged — so the diff transport drops it. `key` is a parameter (not a loop local) so each row's
// closure captures its own key. A vanished key renders empty (the row clears).
fn keyed_row<T>(
    source: Signal<List<T>>,
    key: string,
    key_of: (T) -> string,
    render_row: (T) -> Html,
): Computed<string> {
    return computed(fn() {
        cur = source.get().filter(fn(x) => key_of(x) == key)
        if cur.len() == 0 {
            return ""
        }
        // Namespace the row's inner markers by its key: inert (the row is patched wholesale) but kept
        // disjoint from the exposed `hN`/`row-K` ids, and stable so an unchanged row stays equal.
        return prefix_markers(render_row(cur[0]).skeleton, key)
    })
}

// One row's inline handlers, key-namespaced (`<key>-eN`) exactly as `prefix_markers` rewrites the
// row's `data-live-*` attributes when it is folded — so a click on the (stable-id) element routes to
// the registered closure. Re-derives the item from the source by key, so a row appended after first
// render still finds its handlers.
fn row_handlers_of<T>(
    source: Signal<List<T>>,
    key: string,
    key_of: (T) -> string,
    render_row: (T) -> Html,
): Map<string, Binding> {
    cur = source.get().filter(fn(x) => key_of(x) == key)
    if cur.len() == 0 {
        return {}
    }
    rh = render_row(cur[0]).handlers
    mut out: Map<string, Binding> = {}
    for hid in rh.keys() {
        out = out.set("${key}-${hid}", rh.get_or(hid, inert_binding()))
    }
    return out
}

// Build a `Keyed` from a list signal: a stable key per item and, deferred, a persistent per-row
// `computed`. `source` is the signal itself (not a snapshot) so each row can re-read it; `key_of`
// gives a row's stable identity; `render_row` renders one item to an `@html` value. The three erased
// closures capture the typed `source`/`key_of`/`render_row` so `render` and the session can build,
// expand, and reconcile the region without `T`.
pub fn keyed<T>(
    source: Signal<List<T>>,
    key_of: (T) -> string,
    render_row: (T) -> Html,
): Keyed {
    return Keyed {
        keys_now: fn() => source.get().map(key_of),
        make_row: fn(k: string) => keyed_row(source, k, key_of, render_row),
        row_handlers: fn(k: string) => row_handlers_of(source, k, key_of, render_row),
    }
}

// The full marker id for a row: `<region>-row-<key>`. Region-namespaced so two keyed lists on one
// page whose keys collide (both `"1"`) still get disjoint DOM ids.
fn row_id(region: string, key: string): string {
    return "${region}-row-${key}"
}

// Reject a key sequence with a repeat — two rows sharing a key would collide on one DOM id, so the
// per-row diff could never tell them apart. Fail loudly and early rather than silently corrupt.
fn ensure_unique_keys(keys: List<string>): void {
    mut seen: List<string> = []
    for k in keys {
        if seen.contains(k) {
            panic("keyed: duplicate key '${k}' — a keyed list's keys must be unique")
        }
        seen = seen ~ [k]
    }
}

// The structural op kinds a keyed diff emits — the single source of truth for the wire `t` tag.
enum KeyOpKind {
    Remove
    Insert
    Move
}

// One structural op: `kind` on the row `key`, positioned immediately before the row `before` (or at
// the region end when `before` is `""`). `render`/reconcile turn this into the wire op, resolving
// `key`/`before` to region-namespaced marker ids and filling an insert's markup.
struct KeyOp {
    kind: KeyOpKind
    key: string
    before: string
}

// The longest-increasing-subsequence of `seq`, returned as the set (list) of *indices* into `seq`
// that participate — the O(n^2) DP with parent backtracking. Used by [`keyed_plan`] to find the
// largest run of survivors already in relative order: those keep their DOM position while every
// other survivor moves. Standard O(n log n) LIS collapses to this at these list sizes.
fn lis_indices(seq: List<int>): List<int> {
    n = seq.len()
    if n == 0 {
        return []
    }
    mut dp: List<int> = []
    mut par: List<int> = []
    mut i = 0
    while i < n {
        dp = dp ~ [1]
        par = par ~ [-1]
        i = i + 1
    }
    i = 0
    while i < n {
        mut j = 0
        while j < i {
            if seq[j] < seq[i] && dp[j] + 1 > dp[i] {
                dp[i] = dp[j] + 1
                par[i] = j
            }
            j = j + 1
        }
        i = i + 1
    }
    mut best = 0
    i = 1
    while i < n {
        if dp[i] > dp[best] {
            best = i
        }
        i = i + 1
    }
    mut out: List<int> = []
    mut k = best
    while k != -1 {
        out = out ~ [k]
        k = par[k]
    }
    return out.reverse()
}

// The keyed reconciliation: diff the previous key sequence into the next one and emit the **minimal**
// structural ops. This is the standard keyed-children algorithm (Vue 3's `patchKeyedChildren` / Solid
// & Inferno's reconcile): anchor the surviving rows on their longest increasing subsequence — those
// stay put — and insert / move everything else, walking `next` back-to-front so each op positions its
// row before an already-placed successor. Removals come first (so later `before` refs never name a
// gone row); inserts/moves follow in that backward order. `before == ""` means "at the region end".
fn keyed_plan(prev: List<string>, next: List<string>): List<KeyOp> {
    mut ops: List<KeyOp> = []
    for k in prev {
        if !next.contains(k) {
            ops = ops ~ [KeyOp { kind: KeyOpKind.Remove, key: k, before: "" }]
        }
    }
    // Survivors (in both), in `next` order, tagged with their position in `prev`.
    mut pos: Map<string, int> = {}
    mut pi = 0
    for k in prev {
        pos = pos.set(k, pi)
        pi = pi + 1
    }
    mut seq: List<int> = []
    mut seq_keys: List<string> = []
    for k in next {
        if prev.contains(k) {
            seq = seq ~ [pos.get_or(k, 0)]
            seq_keys = seq_keys ~ [k]
        }
    }
    keep_idx = lis_indices(seq)
    mut keep: List<string> = []
    mut si = 0
    for k in seq_keys {
        if keep_idx.contains(si) {
            keep = keep ~ [k]
        }
        si = si + 1
    }
    mut before = ""
    mut j = next.len() - 1
    while j >= 0 {
        k = next[j]
        if !prev.contains(k) {
            ops = ops ~ [KeyOp { kind: KeyOpKind.Insert, key: k, before: before }]
        } else if !keep.contains(k) {
            ops = ops ~ [KeyOp { kind: KeyOpKind.Move, key: k, before: before }]
        }
        before = k
        j = j - 1
    }
    return ops
}

// A compact, deterministic description of the structural ops a key-sequence change patches — the
// same minimal plan `reconcile_region` applies, but without markup or exposure. An introspection and
// testing aid: given the previous and next key order it names exactly the insert / remove / move ops.
// Ops are `; `-joined; `ins`/`mv` name the successor key they land before (`@end` at the tail).
pub fn keyed_op_stream(prev: List<string>, next: List<string>): string {
    plan = keyed_plan(prev, next)
    mut parts: List<string> = []
    for op in plan {
        anchor = if op.before == "" then "@end" else op.before
        tag = match op.kind {
            KeyOpKind.Remove => "rm ${op.key}",
            KeyOpKind.Insert => "ins ${op.key} ${anchor}",
            KeyOpKind.Move => "mv ${op.key} ${anchor}",
        }
        parts = parts ~ [tag]
    }
    return parts.join("; ")
}

// The result of reconciling one region for one event: the wire frame to push (empty when the key
// sequence did not change) and the page's updated handler table (rows in/out change the set of bound
// closures).
pub struct Reconcile {
    frame: string
    handlers: Map<string, Binding>
}

// Reconcile one keyed region against the current key sequence and produce its structural patch.
// Removed rows are **unexposed** (`view.unexpose` disposes the per-row `computed` — its reactive
// scope is reclaimed on the spot, so a churning list leaves residency flat); inserted rows get a
// fresh `computed`, exposed under their marker id, with their initial markup carried inline in the
// op; moved rows keep their `computed` and their DOM element (state and focus survive the reorder).
// The content of surviving rows still rides the ordinary per-row diff — this only moves the boxes.
pub fn reconcile_region(reg: KeyedRegion, v: View, handlers: Map<string, Binding>): Reconcile {
    keys_now = reg.keys_now
    make_row = reg.make_row
    row_handlers = reg.row_handlers
    prev = reg.prev.get()
    next = keys_now()
    if prev == next {
        return Reconcile { frame: "", handlers: handlers }
    }
    ensure_unique_keys(next)
    plan = keyed_plan(prev, next)
    mut h = handlers
    mut parts: List<string> = []
    for op in plan {
        rid = row_id(reg.region, op.key)
        before_ref = if op.before == "" then "@end" else row_id(reg.region, op.before)
        match op.kind {
            KeyOpKind.Remove => {
                v.unexpose(rid)
                // The row is gone from the source, so re-deriving its handlers yields nothing — drop
                // by its `<key>-` id namespace instead (the same one `keyed`/`prefix_markers` use).
                prefix = "${op.key}-"
                for hid in h.keys() {
                    if hid.starts_with(prefix) {
                        h = h.remove(hid)
                    }
                }
                parts = parts ~ ["{\"t\":\"rm\",\"id\":\"${rid}\"}"]
            },
            KeyOpKind.Insert => {
                c = make_row(op.key)
                v.expose(rid, c)
                rh = row_handlers(op.key)
                for hid in rh.keys() {
                    h = h.set(hid, rh.get_or(hid, inert_binding()))
                }
                inner = computed_string(c)
                html = "<span data-live-html=\"${rid}\">${inner}</span>"
                parts = parts ~ ["{\"t\":\"ins\",\"id\":\"${rid}\",\"before\":\"${before_ref}\",\"html\":${json.stringify(html)}}"]
            },
            KeyOpKind.Move => {
                parts = parts ~ ["{\"t\":\"mv\",\"id\":\"${rid}\",\"before\":\"${before_ref}\"}"]
            },
        }
    }
    reg.prev.set(next)
    joined = parts.join(",")
    frame = "{\"type\":\"keyed\",\"region\":\"${reg.region}\",\"ops\":[${joined}]}"
    return Reconcile { frame: frame, handlers: h }
}

// Fold `from`'s inline handlers into `into` under `prefix` — the same prefix `prefix_markers` gives
// the folded region's `data-live-*` attributes, so a registered id (`s-e0`, `c1-e0`, `<key>-e0`)
// matches the attribute the client reports. Used to hoist a nested/keyed child's handlers up to the
// page's single dispatch table.
fn merge_handlers(
    into: Map<string, Binding>,
    from: Map<string, Binding>,
    prefix: string,
): Map<string, Binding> {
    mut out = into
    for hid in from.keys() {
        out = out.set("${prefix}${hid}", from.get_or(hid, inert_binding()))
    }
    return out
}

// The `@html` handler. Holes are `() -> dyn` — a template renders *any* value (like JSX `{x}`) — so
// `${count.get()}` needs no `.to_string()` and `${rows.map(row)}` composes nested templates. Each
// hole is wrapped in a `computed` so it tracks exactly the signals it reads and recomputes only when
// they change; the diff transport then pushes only the holes whose rendered value differs. A markup
// hole gets a `data-live-html` marker (the client applies patches via `innerHTML`); a text hole a
// `data-live` marker (`textContent`, escaped).
//
// A hole in *attribute* position that is an `on_*(…)` `Binding` is not rendered as text: it registers
// its closure in `handlers` under an auto id (`eN`) and emits the event's `data-live-*` marker. A
// nested `Html`/`List<Html>` folded into a text hole contributes *its* handlers too (prefix-namespaced
// to match `prefix_markers`), so the page ends with one flat dispatch table over every bound element.
@tier(html, text: "html", expr: Html)
pub fn render(statics: List<string>, holes: List<() -> dyn>): Html {
    mut skeleton = ""
    mut exposed: List<dyn> = []
    mut ids: List<string> = []
    mut handlers: Map<string, Binding> = {}
    mut regions: List<KeyedRegion> = []
    // Attribute bindings whose element has not closed its tag yet — `aN:name` pairs, emitted as one
    // `data-live-attr` on the element as soon as a static carries the `>`. Carried rather than
    // emitted immediately because a hole in attribute position sits inside a quoted value, where no
    // new attribute can be written; several holes in one tag accumulate here.
    mut pending_attr = ""
    mut i = 0
    for s in statics {
        mut chunk = s
        if pending_attr != "" && s.index_of(">") != none {
            chunk = inject_at_tag_close(s, "data-live-attr=\"${pending_attr}\"")
            pending_attr = ""
        }
        skeleton = skeleton ~ chunk
        if i < holes.len() {
            hole = holes[i]
            val = hole()
            keyed_val = val.as<Keyed>()
            binding = val.as<Binding>()
            if keyed_val != none {
                // A keyed list: expand into one `data-live-html` region *per row* (exposing each row's
                // own persistent `computed`, so a change to one row diffs only that row), then close
                // with a hidden end-anchor the session inserts before when appending. Record a
                // `KeyedRegion` so the session can reconcile structural changes after each event.
                k = keyed_val ?? Keyed { keys_now: fn() => [], make_row: fn(_: string) => computed(fn() => ""), row_handlers: fn(_: string) => {} }
                region = "k${i}"
                keys_now = k.keys_now
                make_row = k.make_row
                row_handlers = k.row_handlers
                keys = keys_now()
                ensure_unique_keys(keys)
                for key in keys {
                    rid = row_id(region, key)
                    rc = make_row(key)
                    ids = ids ~ [rid]
                    exposed = exposed ~ [rc]
                    skeleton = skeleton ~ "<span data-live-html=\"${rid}\">" ~ computed_string(rc) ~ "</span>"
                    handlers = merge_handlers(handlers, row_handlers(key), "")
                }
                skeleton = skeleton ~ "<span data-live-keyed=\"${region}\" hidden></span>"
                regions = regions ~ [KeyedRegion {
                    region: region,
                    prev: signal(keys),
                    keys_now: k.keys_now,
                    make_row: k.make_row,
                    row_handlers: k.row_handlers,
                }]
            } else if in_tag(skeleton) && binding != none {
                // Attribute position, inline event handler: register the closure and emit the event's
                // wire marker (`data-live-click="eN"`) so a client event routes straight to it.
                b = binding ?? inert_binding()
                hid = "e${i}"
                handlers = handlers.set(hid, b)
                skeleton = skeleton ~ "${wire_attr(b.event)}=\"${hid}\""
            } else if in_tag(skeleton) {
                // Attribute position: inline the escaped value — a `<span>` marker would be illegal
                // inside a tag — and *also* expose it as its own hole, so the attribute tracks its
                // signals like any other. The marker naming the binding cannot go here (we are
                // inside a quoted value), so it is carried to the element's `>` (`pending_attr`).
                //
                // Inlining alone used to be the whole story, on the reasoning that such a hole
                // re-renders with its enclosing region. True inside a keyed row; false everywhere
                // else, and the page root is not a region — so `value="${draft.get()}"` rendered
                // once and then never again, and no server-side change could clear an input.
                attr = attr_name_at(skeleton)
                skeleton = skeleton ~ attr_escape("${val}")
                if attr != "" {
                    c = computed(fn() => attr_escape("${hole()}"))
                    hid = "a${i}"
                    ids = ids ~ [hid]
                    exposed = exposed ~ [c]
                    pending_attr = if pending_attr == "" then "${hid}:${attr}" else "${pending_attr} ${hid}:${attr}"
                }
            } else {
                // Text position: wrap the hole in a `computed` (tracks exactly the signals it reads)
                // behind a `data-live`/`data-live-html` marker the session exposes and diffs. A folded
                // child template's handlers are hoisted under the same prefix its markers get.
                c = computed(fn() => render_value(hole()))
                hid = "h${i}"
                ids = ids ~ [hid]
                exposed = exposed ~ [c]
                marker = if is_markup(val) then "data-live-html" else "data-live"
                skeleton = skeleton ~ "<span ${marker}=\"${hid}\">" ~ c.get() ~ "</span>"
                child = val.as<Html>()
                if child != none {
                    handlers = merge_handlers(handlers, (child ?? Html { skeleton: "", holes: [], ids: [], handlers: {}, regions: [] }).handlers, "s-")
                }
                children = val.as<List<Html>>()
                if children != none {
                    mut ci = 0
                    for c2 in children ?? [] {
                        handlers = merge_handlers(handlers, c2.handlers, "c${ci}-")
                        ci = ci + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return Html { skeleton: skeleton, holes: exposed, ids: ids, handlers: handlers, regions: regions }
}

// A row's initial rendered value for the first-paint skeleton. `c` is a `Computed<string>` carried
// as `dyn` (so it can sit alongside the other holes); `.get()` dispatches at runtime.
fn computed_string(c: dyn): string {
    return "${c.get()}"
}

// The client runtime — the bundled `server.liveview_js()` shim, extended so a **markup** hole
// (`data-live-html`) patches via `innerHTML` while a **text** hole (`data-live`) patches via
// `textContent` (escaped). The wire protocol is unchanged (hole → string); the marker attribute
// alone decides text-vs-markup, so a reactive loop of `<li>` rows updates in place.
fn live_js(): string {
    return `(() => {
  "use strict";
  // Where to open the socket. The server writes it onto this script tag as data-live-ws, derived
  // from the same mount base the shim's own URL was, so a page mounted under a prefix connects to
  // ITS socket rather than the root's — the two cannot drift, because one value produced both.
  // window.NOETA_LIVE_PATH still wins when set: a deployment behind a proxy that rewrites paths is
  // the case the server cannot know about.
  const tag = document.currentScript;
  const path = window.NOETA_LIVE_PATH || (tag && tag.dataset.liveWs) || "/ws";
  const state = {};
  let ws = null;
  const unescapeAttr = (s) => s.replace(/&quot;/g, '"').replace(/&gt;/g, ">").replace(/&lt;/g, "<").replace(/&amp;/g, "&");
  const render = (name) => {
    const value = state[name];
    const text = typeof value === "string" ? value : JSON.stringify(value);
    document.querySelectorAll('[data-live="' + name + '"]').forEach((el) => { el.textContent = text; });
    document.querySelectorAll('[data-live-html="' + name + '"]').forEach((el) => { el.innerHTML = text; });
    // Attribute holes: the element carries data-live-attr="aN:name aM:other". The value arrives
    // attribute-escaped (it was written into a quoted value server-side), so unescape it first.
    document.querySelectorAll("[data-live-attr]").forEach((el) => {
      for (const pair of el.dataset.liveAttr.split(" ")) {
        const [id, attr] = pair.split(":");
        if (id !== name) continue;
        const v = unescapeAttr(text);
        // value/checked are live properties: setting only the attribute leaves what the user
        // sees untouched once the element has been interacted with.
        if (attr === "value") { if (el.value !== v) el.value = v; }
        else if (attr === "checked") { el.checked = v !== "" && v !== "false"; }
        else el.setAttribute(attr, v);
      }
    });
  };
  const apply = (values) => { for (const n of Object.keys(values)) { state[n] = values[n]; render(n); } };
  const anchor = (id) => id === "@end" ? null : document.querySelector('[data-live-html="' + id + '"]');
  const keyed = (frame) => {
    const end = document.querySelector('[data-live-keyed="' + frame.region + '"]');
    for (const op of frame.ops) {
      if (op.t === "rm") {
        const el = document.querySelector('[data-live-html="' + op.id + '"]');
        if (el) el.remove();
        continue;
      }
      const before = op.before === "@end" ? end : anchor(op.before);
      if (!before) continue;
      if (op.t === "ins") { before.insertAdjacentHTML("beforebegin", op.html); }
      else if (op.t === "mv") {
        const el = document.querySelector('[data-live-html="' + op.id + '"]');
        if (el) before.parentNode.insertBefore(el, before);
      }
    }
  };
  const handle = (frame) => {
    if (frame.type === "snapshot") apply(frame.values);
    else if (frame.type === "patch") apply(frame.changes);
    else if (frame.type === "keyed") keyed(frame);
    else if (frame.type === "reload") location.reload();
    else if (frame.type === "error") console.error("noeta live:", frame.message);
  };
  const connect = () => {
    const scheme = location.protocol === "https:" ? "wss://" : "ws://";
    ws = new WebSocket(scheme + location.host + path);
    ws.onmessage = (e) => handle(JSON.parse(e.data));
    ws.onclose = () => setTimeout(connect, 1000);
  };
  const send = (name, value) => { if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: "event", name, value: value || "" })); };
  document.addEventListener("click", (e) => {
    const el = e.target.closest("[data-live-click]");
    if (el) send(el.dataset.liveClick, "");
  });
  document.addEventListener("input", (e) => {
    const el = e.target.closest("[data-live-input]");
    if (el) send(el.dataset.liveInput, el.value);
  });
  document.addEventListener("submit", (e) => {
    const el = e.target.closest("[data-live-submit]");
    if (el) { e.preventDefault(); send(el.dataset.liveSubmit, new URLSearchParams(new FormData(el)).toString()); }
  });
  window.noetaLive = { state, send };
  connect();
})();
`
}

// Wrap a rendered template in a full HTML document with the bundled client shim.
//
// The script tag carries the socket URL (`data-live-ws`) rather than leaving the shim to guess it.
// Both URLs are built from the same normalized `base` here, in one expression, which is what keeps a
// mounted page's shim pointed at the mount's own socket: the shim used to default to `/ws` whatever
// prefix it had been served under, so every page mounted at a prefix loaded its client from
// `<base>/live.js` and then tried to connect to a socket nobody was serving.
fn document(title: string, page: Html, styles: ?Css, base: string): string {
    root = base_root(base)
    style_tag = match styles {
        some(c) => "<style>${c.text}</style>",
        none => "",
    }
    head = "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>${title}</title>${style_tag}</head><body>\n"
    return "${head}${page.skeleton}\n<script src=\"${root}/live.js\" data-live-ws=\"${root}/ws\"></script></body></html>\n"
}

// A page with no holes — enough to serve, which is all `document` needs. Written out rather than
// rendered through `@html` so the document tests state their own input and do not move when the
// tier handler's markup does.
fn bare_page(markup: string): Html {
    return Html { skeleton: markup, holes: [], ids: [], handlers: {}, regions: [] }
}

// The served document tells the client where its socket is, and both URLs carry the mount. This is
// the drift that made `base:` unusable: the shim was fetched from `<base>/live.js` and then opened
// `/ws` regardless, so every mounted page loaded a client that connected to a socket the mount was
// not serving — and at the root, where the two agree by accident, nothing showed it.
@test fn a_mounted_document_points_its_shim_at_its_own_socket(): void {
    doc = document("Todos", bare_page("<main></main>"), none, "/todos")
    assert(doc.contains("src=\"/todos/live.js\""))
    assert(doc.contains("data-live-ws=\"/todos/ws\""))
}

@test fn a_root_document_serves_the_unprefixed_urls(): void {
    for base in ["", "/"] {
        doc = document("Todos", bare_page("<main></main>"), none, base)
        assert(doc.contains("src=\"/live.js\""))
        assert(doc.contains("data-live-ws=\"/ws\""))
        // The `"/"` spelling must not reach the markup as `//live.js`: a browser reads a
        // protocol-relative URL there and asks a host named `live.js` for it.
        assert(!doc.contains("//live.js"))
        assert(!doc.contains("//ws"))
    }
}

// The shim reads the attribute the document writes. Two halves of one protocol living in two
// strings, so the pin is here: rename either side and this fails rather than the socket silently
// falling back to the root's `/ws`.
@test fn the_shim_reads_the_socket_url_off_its_own_script_tag(): void {
    assert(live_js().contains("dataset.liveWs"))
    assert(live_js().contains("document.currentScript"))
}

// One wake of a live session: a client frame, or an idle tick. The unit an interceptor layers over —
// para/html's own vocabulary for "something happened", carrying nothing about who the client is.
//
// `origin` is the request that opened the socket, carried so a layer can recover whatever the upgrade
// carried (a cookie, a header). This package never reads it; it only hands it over.
//
// Every field is `pub`: a wake is the value a *host framework* layers over, and a layer that cannot
// read what it is layering over is useless. Contrast `Binding`, whose fields stay private — a binding
// is this package's own bookkeeping, and only `dispatch` has business running one.
pub struct Wake {
    // The handler id the client named and the payload it sent. Both empty on an idle tick.
    name: string
    value: string
    // True when no client frame arrived — the session woke on its own timer. A tick runs `on_tick`
    // rather than a handler, and is exempt from the client-facing limits: there is no client behind
    // it to rate-limit, and no payload to bound.
    tick: bool
    // The request that opened the socket, or `none` on the browserless path — the same shape and the
    // same reason as aether's `request_arg(req: ?Request)`: a live request exists only on the server
    // path, and forcing one would make the onion untestable without a real socket. A layer that needs
    // the request must decide what absence means for it, and should fail closed.
    origin: ?Request
}

// Build a wake by hand. The socket path builds its own with `wake_of`; this is the door a *host
// framework* tests its layers through, without a browser or a socket — the same reason `dispatch` and
// `within_limits` are `pub`. A wake built here carries no origin.
pub fn wake(name: string, value: string, tick: bool): Wake {
    return Wake { name: name, value: value, tick: tick, origin: none }
}

// Parse one wake off the socket. A malformed or non-`event` frame yields a wake bound to no handler,
// which `dispatch` then refuses by id — so a garbage frame costs a parse and nothing else.
fn wake_of(msg: ?string, idle: bool, origin: Request): Wake {
    if idle {
        return Wake { name: "", value: "", tick: true, origin: some(origin) }
    }
    evt = json.parse(msg ?? "{}")
    if "${evt["type"]}" != "event" {
        return Wake { name: "", value: "", tick: false, origin: some(origin) }
    }
    return Wake { name: "${evt["name"]}", value: "${evt["value"]}", tick: false, origin: some(origin) }
}

// --- The unconditional limits. -----------------------------------------------------------------
//
// These are enforced in `session` itself, for every page, with no way to opt out and no interceptor
// involved. That placement is the deliberate part. The obvious alternative is to ship them as onion
// layers in the companion `para/aether_html` package — but a layer only exists on the *mounted* path,
// which would leave the standalone one-file page (`handle(req, title, page)`, the simplest and most
// common way a LiveView app gets written) as the one with no protections at all. A limit no app
// should have to ask for belongs where every app already is.
//
// The division the arc settles on: para/html carries the limits, the onion carries app policy.

// The largest event payload a client may send, in characters. Generous for anything this wire is
// for — a click carries nothing, an input carries a field, a submit carries a form — and small
// enough that a hostile frame cannot make the server hold an arbitrary string. A frame over the cap
// is dropped whole: it never reaches a handler, an interceptor, or the reactive graph. File uploads
// do not belong on this wire; they belong on an ordinary HTTP route.
pub fn max_payload_chars(): int {
    return 262144
}

// The most client frames a session will admit per second. Well above any human input rate — fast
// typing on an `on_input` is ~15/s and a dragged range input ~60/s — so it bounds a flood by an order
// of magnitude without ever touching a real interaction. Frames over the cap are dropped, not queued:
// queueing a flood is how a rate limit becomes the memory exhaustion it was meant to prevent.
//
// Measured against `datetime.now()`, the real wall clock. `time.monotonic()` cannot serve here — it
// is a *logical* counter that advances one tick per call and only tracks real time across an explicit
// sleep, so a rate computed from it would be meaningless.
pub fn max_frames_per_second(): int {
    return 120
}

// Whether a wake clears the unconditional limits. `in_window` is how many client frames have been
// counted in the current one-second window, this one included.
//
// A tick always clears: it has no client behind it to rate-limit and no payload to bound. Everything
// else is decided here rather than inline in `session` for the same reason `dispatch` is a function —
// the loop needs a socket to run, so a decision left inside it could not be tested without one, and
// an untestable limit is a limit that quietly stops holding.
pub fn within_limits(tick: bool, payload: string, in_window: int): bool {
    if tick {
        return true
    }
    if payload.len() > max_payload_chars() {
        return false
    }
    return in_window <= max_frames_per_second()
}

// How often an idle session wakes to publish state that changed with no client event behind it.
// Short enough to feel immediate, long enough that an idle page costs a timer and a diff check.
// `handle`'s `every_ms:` overrides it for a page that wants a different cadence.
pub fn poll_ms(): int {
    return 500
}

// One websocket session: a `view()` over the page's hole computeds, the full snapshot, then a loop.
// Two things wake it, and both end at the same push:
//
//   * a **client event** — look the element's inline handler up in the page's `handlers` table and
//     run it with the event payload;
//   * an **idle tick** — no client event, so run `on_tick` (where an app pulls whatever it syncs
//     from outside the page) and diff anyway.
//
// The tick is what makes the page reactive to anything the *browser* did not cause. A session
// blocked in a plain `recv` is deaf to its own server: another user's click, a peer's message
// arriving over p2p, a finished job — all of them changed the reactive graph, and none of them
// could reach the page until this browser happened to click something. `recv_timeout` is what a
// tick needs; `race(recv, timer)` cannot do it, because cancelling the losing recv drops messages
// the client did send.
async fn session(
    sock: Socket,
    render_page: () -> Html,
    every_ms: int,
    on_tick: () -> void,
    origin: Request,
    intercept: ?(Wake, () -> void) -> void,
): bool {
    page = render_page()
    v = view()
    mut i = 0
    for c in page.holes {
        v.expose(page.ids[i], c)
        i = i + 1
    }
    // The dispatch table changes across the session — a keyed row that joins registers its inline
    // handlers, a row that leaves drops them (see `reconcile_region`) — and the wake thunk below
    // both reads and replaces it. A `signal` rather than a `mut` local because a closure captures a
    // binding, not a cell: the same reason `KeyedRegion.prev` is a signal.
    table = signal(page.handlers)
    sock.send(v.snapshot())
    // Frame-rate accounting for `within_limits`, carried across iterations: the current one-second
    // window's start (real ms) and how many frames have been admitted inside it.
    mut window_start = datetime.now().unix_ms()
    mut in_window = 0
    mut going = true
    while going {
        msg = sock.recv_timeout(every_ms).await
        // `none` is either "nothing arrived this tick" or "the peer is gone" — `closed()` decides.
        idle = msg == none && !sock.closed()
        if msg == none && !idle {
            going = false
        } else {
            w = wake_of(msg, idle, origin)
            // The unconditional limits, checked before ANY app code runs and before an interceptor
            // is consulted — see `max_payload_chars`/`max_frames_per_second` for why they are not
            // layers. A tick is exempt: it has no client behind it to rate-limit or oversize.
            now_ms = datetime.now().unix_ms()
            if now_ms - window_start >= 1000 {
                window_start = now_ms
                in_window = 0
            }
            in_window = in_window + 1
            if within_limits(w.tick, w.value, in_window) {
                // The rest of the wake, as a value: run the handler (or the tick), reconcile every
                // keyed region, push the diff. Handed to an interceptor as its `next` so a layer can
                // wrap the whole wake — measure it, or decline to run it — exactly as aether's
                // `Next.run` is the rest of an HTTP pipeline. See `docs/FrameOnion.md`.
                proceed = fn() {
                    if w.tick {
                        on_tick()
                    } else {
                        // Guard-then-run, checked HERE — on the wake the event arrived on, not at
                        // the render that emitted the marker (see `Binding.guard`). The verdict is
                        // dropped: the reconcile and diff below run either way, so a refused event
                        // simply leaves the page as it was.
                        dispatch(table.get(), w.name, w.value)
                    }
                    // Structural reconcile first — a keyed list may have gained, lost, or reordered
                    // rows; push its minimal insert/remove/move ops, and unexpose/expose the affected
                    // row bindings so the content diff that follows neither pushes a gone row nor
                    // re-pushes a fresh one.
                    for reg in page.regions {
                        res = reconcile_region(reg, v, table.get())
                        table.set(res.handlers)
                        if res.frame != "" {
                            sock.send(res.frame)
                        }
                    }
                    patch = v.diff() ?? ""
                    if patch != "" {
                        sock.send(patch)
                    }
                }
                match intercept {
                    none => proceed(),
                    some(layer) => layer(w, proceed),
                }
            }
        }
    }
    return true
}

// The mount prefix in its canonical form: no trailing slash, and the root spelled as the empty
// string. `""` and `"/"` are the same mount and `"/todos/"` is the same mount as `"/todos"`, so the
// three URLs are built from one normalized value instead of from whatever the caller typed —
// `"/" ~ "/ws"` is `"//ws"`, a socket path no browser would ever ask for.
//
// Every place that turns a base into a URL or compares one goes through here: `serves`, `handle`,
// and `document`. That is the point — the shim's `src`, the socket it connects to, and the predicate
// a host framework gates the mount with are then three readings of a single rule.
fn base_root(base: string): string {
    if base == "/" {
        return ""
    }
    if base.ends_with("/") {
        return base.slice(0, base.len() - 1)
    }
    return base
}

// Whether `path` is one of the three URLs a LiveView page mounted at `base` owns — the page itself,
// its websocket, or its client shim. ONE predicate, used by `handle`'s own routing and by any host
// framework gating a mount, so the two can never disagree about which URLs are a page's.
//
// A page mounted at the **root** (`""` or `"/"`) owns exactly `/`, `/ws` and `/live.js`, and nothing
// else: it is the natural spelling for the app whose live page IS its home page, and it has to leave
// `/health` and `/api/…` alone for the router beside it. This predicate used to answer `true` for
// every path at the root, which made that app inexpressible — the one arrangement most apps want —
// and left it hand-writing the three URLs in its own `fetch`.
//
// The standalone page's catch-all is unaffected and lives where it always did: `handle` renders the
// document for any path that is not the socket or the shim, which is what makes a one-file app a
// whole site with no router. That is a property of serving the page directly, not of where it is
// mounted, so it belongs to `handle` rather than to this rule.
pub fn serves(base: string, path: string): bool {
    root = base_root(base)
    return path == root || path == root ~ "/" || path == root ~ "/ws" || path == root ~ "/live.js"
}

// The three spellings of the root mount are one mount, and a trailing slash never reaches a URL.
// `"/" ~ "/ws"` is the failure this rules out: a socket at `//ws` that nothing serves and no client
// asks for.
@test fn a_base_normalizes_to_one_canonical_prefix(): void {
    assert(base_root("") == "")
    assert(base_root("/") == "")
    assert(base_root("/todos") == "/todos")
    assert(base_root("/todos/") == "/todos")
}

// The root mount claims its own three URLs and NOTHING else — the property that lets a live page be
// an app's home page while the router beside it keeps `/health` and `/api/todos`. Before this, the
// root answered `true` for every path, so an app with both had to route the page by hand.
@test fn a_root_mount_claims_three_urls_and_leaves_the_rest(): void {
    for base in ["", "/"] {
        assert(serves(base, "/"))
        assert(serves(base, "/ws"))
        assert(serves(base, "/live.js"))
        assert(!serves(base, "/health"))
        assert(!serves(base, "/api/todos"))
    }
}

// A prefixed mount claims the prefix, with or without its trailing slash, and stays inside it: a
// sibling whose name merely starts the same way (`/todos-archive`) is not this page's.
@test fn a_prefixed_mount_claims_its_own_three_urls(): void {
    assert(serves("/todos", "/todos"))
    assert(serves("/todos", "/todos/"))
    assert(serves("/todos", "/todos/ws"))
    assert(serves("/todos", "/todos/live.js"))
    assert(!serves("/todos", "/todos/other"))
    assert(!serves("/todos", "/todos-archive"))
    assert(!serves("/todos", "/ws"))
}

// Handle one request: the websocket upgrade (the diff-push session), the bundled client shim, or the
// server-rendered page. An app's `fn fetch(req)` delegates here, so it runs under `noeta serve` like
// any `std.http.server` app. `render_page` produces the reactive page (an `@html` value); its inline
// `on_*(…)` bindings carry their own handlers, so no separate event callback is needed.
//
// One door with defaults rather than a family of entry points. Everything past `render_page` is
// optional and named at the call site, which reads better than the four overlapping functions this
// replaces and — more to the point — stays readable as knobs accumulate:
//
//     handle(req, "Counter", page)                                  // the whole standalone story
//     handle(req, "Styled", page, styles: some(sheet))              // was `handle_styled`
//     handle(req, "Chat", page, every_ms: 250, on_tick: drain)      // was `handle_every`
//     handle(req, "Todos", page, base: "/todos", intercept: onion)  // mounted, with a frame onion
//
// `every_ms` is the idle-tick cadence (`poll_ms()`); `on_tick` runs on each idle wake, before the
// diff, and is where an app pulls state it syncs from elsewhere — a Postgres `NOTIFY` queue, a p2p
// transport. `styles` emits a `@css` value into the document `<head>`, so a page carries its own
// styles without an asset route.
//
// `intercept` is the seam the companion `para/aether_html` package builds its per-frame onion on: a
// layer receives each `Wake` and the rest of the work as a thunk, so it may measure the wake, run it,
// or decline to. It is phrased in nothing but this package's own vocabulary — para/html never learns
// what a user or a permission is. The unconditional limits in `session` are NOT part of it and cannot
// be layered away; see `max_payload_chars`.
//
// `base` mounts the page under a prefix (`"/todos"` serves `/todos`, `/todos/ws`, `/todos/live.js`).
// Empty — the default — is the page at the root, serving `/`, `/ws` and `/live.js`; called directly
// like this it also answers every unmatched path, which is what makes a one-file app a whole site
// with no router. Under a host framework that catch-all never fires, because the mount only hands
// over the paths `serves` claims. `"/"` and a trailing slash are accepted and mean the same mount
// (`base_root`). Each mount serves its own copy of the shim rather than sharing one app-wide: the
// copies are identical and browser-cached per URL, and the alternative splits ownership of a
// para/html route between this package and whatever mounted it, which is how the two modes drift.
pub fn handle(
    req: Request,
    title: string,
    render_page: () -> Html,
    every_ms: int = 500,
    on_tick: () -> void = fn() {},
    styles: ?Css = none,
    intercept: ?(Wake, () -> void) -> void = none,
    base: string = "",
): Response {
    root = base_root(base)
    if req.path() == root ~ "/ws" {
        return server.websocket(fn(sock) => session(sock, render_page, every_ms, on_tick, req, intercept))
    }
    if req.path() == root ~ "/live.js" {
        return server.response(200, live_js(), {"content-type": "application/javascript"})
    }
    return server.response(200, document(title, render_page(), styles, base), {"content-type": "text/html"})
}
