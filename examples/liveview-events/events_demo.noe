// Inline event binding, exercised without a browser. `page()` builds an `@html` value whose buttons,
// input, and per-row `<li>`s each bind their handler *inline* with `on_click`/`on_input`; the `@html`
// handler registers every closure in `page.handlers` under an auto id and emits the matching
// `data-live-*` marker. `fire` simulates a client event by looking the closure up by id and running
// it with the event payload — exactly what the websocket `session` does. Run:
//
//   cd examples/liveview-events && noeta run events_demo.noe
//
// expect: stdout "true"
// expect: stdout "true"
// expect: stdout "2"
// expect: stdout "0"
// expect: stdout "Ada"
// expect: stdout "true"
// expect: stdout "true"
// expect: stdout "true"
// expect: stdout "true"
// expect: stdout "false"
// expect: stdout "buy milk"
// expect: exit 0
use para.html
use para.html.{render, Html, keyed, on_click, on_input, on_submit}
use std.reactive.signal

count = signal(0)
name = signal("")
submitted = signal("")

struct Item {
    id: int
    label: string
    done: bool
}

items = signal([
    Item { id: 1, label: "a", done: false },
    Item { id: 2, label: "b", done: false },
])

fn toggle(id: int) use (items): void {
    items.update(fn(xs) => xs.map(fn(x) => if x.id == id then Item { id: x.id, label: x.label, done: !x.done } else x))
}

// A per-row `<li>` binds its own click — the closure captures *this* row's id. `keyed` hoists it into
// the page table under the row's key (`<id>-e0`), so a per-item handler routes correctly.
fn row(it: Item): Html {
    return @html { <li ${on_click(fn() => toggle(it.id))}>${it.label}</li> }
}

fn page() use (count, items, name, submitted): Html {
    return @html {
        <button ${on_click(fn() => count.update(fn(n) => n + 1))}>+1</button>
        <button ${on_click(fn() => count.set(0))}>reset</button> <input ${on_input(fn(v) => name.set(v))} value="${name.get()}" placeholder="name">
        <form ${on_submit(fn(f) => submitted.set(f["title"]))}><input name="title">
          <button type="submit">add</button>
        </form>
        <ul>${keyed(items, fn(x) => "${x.id}", row)}</ul>
    }
}

// Simulate one client event through the package's own dispatch — the same function the websocket
// session calls, guard check included, so this browserless rehearsal cannot drift from the server.
fn fire(p: Html, id: string, value: string): void {
    html.dispatch(p.handlers, id, value)
}

fn main() use (count, items, name, submitted): void {
    p = page()
    // Top-level bindings: +1 = e0, reset = e1, input = e2 (by hole order); markers are emitted.
    echo p.skeleton.contains("data-live-click=\"e0\"")
    echo p.skeleton.contains("data-live-input=\"e2\"")
    fire(p, "e0", "")
    fire(p, "e0", "")
    echo count.get()
    fire(p, "e1", "")
    echo count.get()
    fire(p, "e2", "Ada")
    echo name.get()
    // An attribute-position hole (`value="${…}"`) is reactive too: it is inlined for first paint
    // *and* exposed as its own hole, with a `data-live-attr` marker on the element naming which id
    // drives which attribute. Without the marker the value rendered once and never again, so the
    // server could not clear an input.
    echo p.skeleton.contains("data-live-attr=\"a3:value\"")
    // Re-rendering the page after the input event shows the attribute tracking its signal.
    echo page().skeleton.contains("value=\"Ada\"")
    // Keyed per-row binding: the row for id=1 registers its click under "1-e0".
    echo p.skeleton.contains("data-live-click=\"1-e0\"")
    fire(p, "1-e0", "")
    echo items.get()[0].done
    echo items.get()[1].done
    // A submit hands the handler the form's DECODED fields, keyed by input name — the raw wire
    // body (`title=buy+milk`) never reaches user code, so no app re-implements percent-decoding.
    fire(p, "e4", "title=buy+milk&note=caf%C3%A9")
    echo submitted.get()
    guards()
}

// Guards are checked at EVENT time, not at render time — the point being that whether an element was
// rendered is decided once, at socket open, while the handler table stays reachable for the whole
// session. So the same registered id runs or does not run purely on what the guard says *now*.
fn guards(): void {
    allowed = signal(false)
    hits = signal(0)
    g = @html { <button ${on_click(fn() => hits.update(fn(n) => n + 1)).only_if(fn() => allowed.get())}>danger</button> }
    // The marker is emitted exactly as for an unguarded binding: a guard is invisible on the wire, so
    // a client cannot tell a guarded element from an open one and probe accordingly.
    echo g.skeleton.contains("data-live-click=\"e0\"")
    // Refused: `dispatch` reports false and the handler never ran.
    echo html.dispatch(g.handlers, "e0", "")
    echo hits.get()
    // Same id, same table, same page — only the guard's verdict changed.
    allowed.set(true)
    echo html.dispatch(g.handlers, "e0", "")
    echo hits.get()
    // An id that was never registered is refused the same silent way as a denied one.
    echo html.dispatch(g.handlers, "e9", "")
}

main()
